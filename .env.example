# Supabase (same project as Newt — Drive tables: drive_users, shared_docs)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public site origin
NEXT_PUBLIC_SITE_URL=https://md1.space

# API tokens for /api/docs are stored in drive_api_tokens (migration 030).
# Users create tokens at /settings. Scripts/agents use MD1_API_TOKEN (see docs/API.md).

# Admin analytics (/admin/analytics) — access is hardcoded in lib/admin.ts.

# Mail client (/mail) — Google OAuth app must allow /api/mail/google/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Any long random value; token blobs are AES-GCM encrypted with a derived key.
MAIL_TOKEN_ENCRYPTION_KEY=

# Optional — feedback widget → Telegram
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_FEEDBACK_CHAT_ID=
